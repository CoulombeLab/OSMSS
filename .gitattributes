# Line endings: shell scripts must keep Unix (LF) endings to run on macOS and Linux;
# Windows batch and PowerShell files use Windows (CRLF) endings.
*.sh       text eol=lf
*.command  text eol=lf
*.cmd      text eol=crlf
*.ps1      text eol=crlf
*.R        text
*.md       text
*.ico      binary
*.icns     binary
*.png      binary
